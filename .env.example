# ── Stats provider ──────────────────────────────────────────
STATS_PROVIDER=mock          # mock | api_football | footystats
API_FOOTBALL_KEY=
FOOTYSTATS_KEY=

# ── Slip builder ────────────────────────────────────────────
SLIP_BUILDER=mock            # mock | playwright | api
ONEXBET_BASE_URL=https://1xbet.ng
HEADLESS=true
BOOKING_API_URL=
BOOKING_API_KEY=

# ── LLM rule parser (optional) ──────────────────────────────
LLM_PROVIDER=none            # none | openai | anthropic | gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Runtime ─────────────────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=INFO
