# ── Live football statistics ────────────────────────────────
# mock | api_football | footystats
STATS_PROVIDER=mock
API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io
API_FOOTBALL_HOST=
FOOTYSTATS_KEY=

# ── Booking provider ─────────────────────────────────────────
# mock | manage_bet_codes | api
SLIP_BUILDER=mock
MANAGE_BET_CODES_BASE_URL=https://api.managebetcodes.app/v1
MANAGE_BET_CODES_API_KEY=
# Examples: sportybet, bet9ja, onexbet, msport, betking
MANAGE_BET_CODES_BOOKMAKER=sportybet
MANAGE_BET_CODES_TIMEOUT_SECONDS=35

# Legacy generic booking API (SLIP_BUILDER=api only)
BOOKING_API_URL=
BOOKING_API_KEY=

# ── Conversational language model ────────────────────────────
# none | openai | anthropic
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Probability calibration ──────────────────────────────────
# Booking is blocked unless a sufficiently large, timestamped out-of-sample dataset exists.
T24_REQUIRE_CALIBRATED=true
T24_CALIBRATION_FILE=data/historical_outcomes.csv
T24_CALIBRATION_MIN_TOTAL=200
T24_CALIBRATION_MIN_BIN=30

# ── Runtime ─────────────────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=INFO
