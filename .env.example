# ── AI web research ─────────────────────────────────────────
# Gemini is the primary live web research provider (Google Search grounding).
LLM_PROVIDER=gemini
GEMINI_API_KEY=PASTE_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Groq automatically backs up conversational parsing if Gemini parsing fails.
# Gemini remains required for grounded live web research; Groq alone is not a web source.
GROQ_API_KEY=PASTE_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# ── Manage Bet Codes ────────────────────────────────────────
SLIP_BUILDER=manage_bet_codes
MANAGE_BET_CODES_BASE_URL=https://api.managebetcodes.app/v1
MANAGE_BET_CODES_API_KEY=PASTE_MANAGE_BET_CODES_API_KEY_HERE
# sportybet or onexbet
MANAGE_BET_CODES_BOOKMAKER=sportybet
MANAGE_BET_CODES_TIMEOUT_SECONDS=45

# ── Probability calibration ─────────────────────────────────
# false allows uncalibrated AI estimates to proceed to exact bookmaker
# market verification. These estimates are NOT statistically calibrated.
T24_REQUIRE_CALIBRATED=false
T24_CALIBRATION_FILE=data/historical_outcomes.csv
T24_CALIBRATION_MIN_TOTAL=200
T24_CALIBRATION_MIN_BIN=30

# ── Runtime ─────────────────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=INFO
