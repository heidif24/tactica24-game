# ── Stats provider ──────────────────────────────────────────
# mock | api_football | footystats
STATS_PROVIDER=mock

# API-Football (https://www.api-football.com / RapidAPI)
API_FOOTBALL_KEY=
# Default direct: https://v3.football.api-sports.io
# RapidAPI:     https://api-football-v1.p.rapidapi.com/v3
API_FOOTBALL_BASE=https://v3.football.api-sports.io
# Only needed for RapidAPI:
API_FOOTBALL_HOST=

# FootyStats (https://footystats.org/api)
FOOTYSTATS_KEY=

# ── Slip builder ────────────────────────────────────────────
# mock | playwright | api
SLIP_BUILDER=mock
ONEXBET_BASE_URL=https://1xbet.ng
HEADLESS=true

# External booking-code API (when SLIP_BUILDER=api)
BOOKING_API_URL=
BOOKING_API_KEY=

# ── LLM rule parser (optional) ──────────────────────────────
# none | openai | anthropic
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Runtime ─────────────────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=INFO
